output "ec2_public_ip {
   description = "Public IP of the instance"
   value = aws_instance.demo_ec2.ec2_public_ip
   sensitive = false 
}

output "ec2_private_ip {
   description = "Private IP of the instance"
   value = aws_instance.demo_ec2.ec2_private_ip
   sensitive = false 
}

output "ec2_instance_arm {
   description = "ARM instance"
   value = aws_instance.demo_ec2.ec2_private_ip
   sensitive = false 
}

output "ec2_instance_id" {
   description = "EC2 instance ID"
   value = aws_instance.demo_ec2.id
}

output "s3_bucket_name" {
   description = "ARM of S3 Bucket"
   value = aws_s3_bucket.demo.bucket.bucket
}

output "iam_user_name" {
   description = "Iam user created by Terraform"
   value = aws_iam_user.demo_user.name
}

output "iam_user_arn" {
   description = "IAM user ARM"
   value = aws_iam_user.demo_user.name
}